{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "lib": ["ES2022"], "strict": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "outDir": "build-test", "rootDir": ".", "sourceMap": true,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "build-test"]
}
